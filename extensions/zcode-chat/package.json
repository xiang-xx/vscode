{
  "name": "zcode-chat",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "zcode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "enabledApiProposals": [
    "chatParticipantAdditions",
    "defaultChatParticipant"
  ],
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capability.untrusted%"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:zcode-chat",
    "watch": "gulp watch-extension:zcode-chat"
  },
  "contributes": {
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "zcode.activeBrain": {
          "type": "string",
          "default": "zcode",
          "enum": [
            "zcode",
            "cursor"
          ],
          "enumDescriptions": [
            "%config.activeBrain.zcode%",
            "%config.activeBrain.cursor%"
          ],
          "description": "%config.activeBrain%"
        },
        "zcode.providerMode": {
          "type": "string",
          "default": "startPlan",
          "enum": [
            "startPlan",
            "bigmodel"
          ],
          "enumDescriptions": [
            "%config.providerMode.startPlan%",
            "%config.providerMode.bigmodel%"
          ],
          "description": "%config.providerMode%"
        },
        "zcode.cursor.agentPath": {
          "type": "string",
          "default": "",
          "description": "%config.cursor.agentPath%"
        },
        "zcode.cursor.mode": {
          "type": "string",
          "default": "agent",
          "enum": [
            "agent",
            "plan",
            "ask"
          ],
          "enumDescriptions": [
            "%config.cursor.mode.agent%",
            "%config.cursor.mode.plan%",
            "%config.cursor.mode.ask%"
          ],
          "description": "%config.cursor.mode%"
        },
        "zcode.cursor.model": {
          "type": "string",
          "default": "",
          "description": "%config.cursor.model%"
        },
        "zcode.model": {
          "type": "string",
          "default": "GLM-5.3-Flash",
          "description": "%config.model%"
        },
        "zcode.reasoningLevel": {
          "type": "string",
          "default": "low",
          "description": "%config.reasoningLevel%"
        },
        "zcode.agentPace": {
          "type": "string",
          "default": "fast",
          "enum": [
            "fast",
            "balanced",
            "thorough"
          ],
          "enumDescriptions": [
            "%config.agentPace.fast%",
            "%config.agentPace.balanced%",
            "%config.agentPace.thorough%"
          ],
          "description": "%config.agentPace%"
        },
        "zcode.chatFontSize": {
          "type": "number",
          "default": 14,
          "minimum": 11,
          "maximum": 24,
          "description": "%config.chatFontSize%"
        },
        "zcode.chatLineHeight": {
          "type": "number",
          "default": 1.8,
          "minimum": 1.3,
          "maximum": 2.4,
          "description": "%config.chatLineHeight%"
        },
        "zcode.completionSound": {
          "type": "boolean",
          "default": true,
          "description": "%config.completionSound%"
        },
        "zcode.bridge.mode": {
          "type": "string",
          "default": "agent",
          "enum": [
            "agent",
            "stub",
            "http"
          ],
          "enumDescriptions": [
            "%config.bridge.mode.agent%",
            "%config.bridge.mode.stub%",
            "%config.bridge.mode.http%"
          ],
          "description": "%config.bridge.mode%"
        },

        "zcode.bridge.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:4096/api/chat",
          "description": "%config.bridge.endpoint%"
        },
        "zcode.oauth.apiOrigin": {
          "type": "string",
          "default": "https://zcode.z.ai",
          "description": "%config.oauth.apiOrigin%"
        }
      }
    },
    "authentication": [
      {
        "id": "zcode",
        "label": "ZCode"
      }
    ],
    "configurationDefaults": {
      "workbench.sideBar.location": "left",
      "zcode.layout.chatPosition": "center",
      "workbench.panel.defaultLocation": "bottom",
      "workbench.secondarySideBar.defaultVisibility": "maximizedInWorkspace",
      "workbench.secondarySideBar.forceMaximized": true,
      "workbench.activityBar.location": "default",
      "workbench.startupEditor": "none"
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "zcode",
          "title": "%container.title%",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "zcode": [
        {
          "type": "webview",
          "id": "zcode.chatView",
          "name": "%view.chat%",
          "visibility": "visible"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "zcode.chat",
        "fullName": "%chat.fullName%",
        "name": "zcode",
        "description": "%chat.description%",
        "isDefault": false,
        "modes": [
          "ask",
          "agent",
          "edit"
        ],
        "commands": [
          {
            "name": "provider",
            "description": "%chat.command.provider%"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "zcode.openChat",
        "title": "%command.openChat%",
        "category": "%command.category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "zcode.addSelectionToChat",
        "title": "%command.addSelectionToChat%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "zcode.newChat",
        "title": "%command.newChat%",
        "category": "%command.category%",
        "icon": "$(plus)"
      },
      {
        "command": "zcode.toggleHistory",
        "title": "%command.toggleHistory%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "zcode.closeActiveTab",
        "title": "%command.closeActiveTab%",
        "category": "%command.category%"
      },
      {
        "command": "zcode.switchBrain",
        "title": "%command.switchBrain%",
        "category": "%command.category%",
        "icon": "$(hubot)"
      },
      {
        "command": "zcode.switchProvider",
        "title": "%command.switchProvider%",
        "category": "%command.category%",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "zcode.switchModel",
        "title": "%command.switchModel%",
        "category": "%command.category%",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "zcode.switchReasoningLevel",
        "title": "%command.switchReasoningLevel%",
        "category": "%command.category%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "zcode.showBridgeStatus",
        "title": "%command.showBridgeStatus%",
        "category": "%command.category%"
      },
      {
        "command": "zcode.manageAccount",
        "title": "%command.manageAccount%",
        "category": "%command.category%",
        "icon": "$(account)"
      },
      {
        "command": "zcode.signIn",
        "title": "%command.signIn%",
        "category": "%command.category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "zcode.signOut",
        "title": "%command.signOut%",
        "category": "%command.category%",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zcode.openChat"
        },
        {
          "command": "zcode.addSelectionToChat"
        },
        {
          "command": "zcode.newChat"
        },
        {
          "command": "zcode.toggleHistory"
        },
        {
          "command": "zcode.closeActiveTab"
        },
        {
          "command": "zcode.switchBrain"
        },
        {
          "command": "zcode.switchProvider"
        },
        {
          "command": "zcode.switchModel"
        },
        {
          "command": "zcode.switchReasoningLevel"
        },
        {
          "command": "zcode.showBridgeStatus"
        },
        {
          "command": "zcode.manageAccount"
        },
        {
          "command": "zcode.signIn"
        },
        {
          "command": "zcode.signOut"
        }
      ],
      "editor/context": [
        {
          "command": "zcode.addSelectionToChat",
          "when": "editorTextFocus",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "zcode.switchBrain",
          "when": "view == zcode.chatView",
          "group": "1_more@1"
        },
        {
          "command": "zcode.switchProvider",
          "when": "view == zcode.chatView",
          "group": "1_more@2"
        },
        {
          "command": "zcode.manageAccount",
          "when": "view == zcode.chatView",
          "group": "1_more@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zcode.openChat",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "zcode.closeActiveTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "focusedView == 'zcode.chatView'"
      },
      {
        "command": "zcode.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
