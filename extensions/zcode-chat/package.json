{
  "name": "zcode-chat",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "zcode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "enabledApiProposals": [
    "chatParticipantAdditions",
    "defaultChatParticipant"
  ],
  "icon": "media/icon.png",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capability.untrusted%"
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:zcode-chat",
    "watch": "gulp watch-extension:zcode-chat"
  },
  "contributes": {
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "zcode.activeBrain": {
          "type": "string",
          "default": "zcode",
          "enum": [
            "zcode",
            "cursor"
          ],
          "enumDescriptions": [
            "%config.activeBrain.zcode%",
            "%config.activeBrain.cursor%"
          ],
          "description": "%config.activeBrain%"
        },
        "zcode.mascot.tts.engine": {
          "type": "string",
          "default": "qwen",
          "enum": [
            "qwen",
            "system",
            "openai"
          ],
          "enumDescriptions": [
            "本地 Qwen3-TTS（Hugging Face 开源权重，参考音频克隆音色；起不来自动退回系统语音）",
            "macOS 系统语音（say，离线、零依赖）",
            "本地 OpenAI 兼容 /audio/speech 服务（GPT-SoVITS、CosyVoice、fish-speech 等的兼容封装）"
          ],
          "description": "桌面精灵台词的语音合成引擎"
        },
        "zcode.mascot.tts.python": {
          "type": "string",
          "default": "",
          "description": "qwen 引擎的 python 解释器（需已装 qwen-tts；留空自动探测，默认先试配音 demo 的 venv）"
        },
        "zcode.mascot.tts.refsDir": {
          "type": "string",
          "default": "",
          "description": "qwen 引擎的参考音色目录：放 名字.wav（可选 名字.txt 写参考文案）即成一个可选音色。留空用 ~/.zcode/mascot-voice-refs"
        },
        "zcode.mascot.tts.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9880/v1",
          "description": "OpenAI 兼容语音服务的地址（engine 为 openai 时使用）"
        },
        "zcode.mascot.tts.model": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容语音服务的模型名（留空用服务端默认）"
        },
        "zcode.mascot.tts.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容语音服务的鉴权（本地服务一般留空）"
        },
        "zcode.mascot.tts.voice": {
          "type": "string",
          "default": "",
          "description": "默认语音：qwen 引擎填参考音色名（clone:名字）；system 引擎填 say 声音名（如 Tingting、Yu-shu）；openai 引擎填 voice 名。留空自动选择"
        },
        "zcode.providerMode": {
          "type": "string",
          "default": "startPlan",
          "enum": [
            "startPlan",
            "bigmodel",
            "deepseek"
          ],
          "enumDescriptions": [
            "%config.providerMode.startPlan%",
            "%config.providerMode.bigmodel%",
            "%config.providerMode.deepseek%"
          ],
          "description": "%config.providerMode%"
        },
        "zcode.cursor.agentPath": {
          "type": "string",
          "default": "",
          "description": "%config.cursor.agentPath%"
        },
        "zcode.cursor.mode": {
          "type": "string",
          "default": "agent",
          "enum": [
            "agent",
            "plan",
            "ask"
          ],
          "enumDescriptions": [
            "%config.cursor.mode.agent%",
            "%config.cursor.mode.plan%",
            "%config.cursor.mode.ask%"
          ],
          "description": "%config.cursor.mode%"
        },
        "zcode.cursor.model": {
          "type": "string",
          "default": "",
          "description": "%config.cursor.model%"
        },
        "zcode.model": {
          "type": "string",
          "default": "GLM-5.3-Flash",
          "description": "%config.model%"
        },
        "zcode.deepseek.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/anthropic",
          "description": "%config.deepseek.baseUrl%"
        },
        "zcode.deepseek.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.deepseek.apiKey%"
        },
        "zcode.reasoningLevel": {
          "type": "string",
          "default": "low",
          "description": "%config.reasoningLevel%"
        },
        "zcode.agentPace": {
          "type": "string",
          "default": "fast",
          "enum": [
            "fast",
            "balanced",
            "thorough"
          ],
          "enumDescriptions": [
            "%config.agentPace.fast%",
            "%config.agentPace.balanced%",
            "%config.agentPace.thorough%"
          ],
          "description": "%config.agentPace%"
        },
        "zcode.chatFontSize": {
          "type": "number",
          "default": 14,
          "minimum": 11,
          "maximum": 24,
          "description": "%config.chatFontSize%"
        },
        "zcode.chatLineHeight": {
          "type": "number",
          "default": 1.8,
          "minimum": 1.3,
          "maximum": 2.4,
          "description": "%config.chatLineHeight%"
        },
        "zcode.bridge.mode": {
          "type": "string",
          "default": "agent",
          "enum": [
            "agent",
            "stub",
            "http"
          ],
          "enumDescriptions": [
            "%config.bridge.mode.agent%",
            "%config.bridge.mode.stub%",
            "%config.bridge.mode.http%"
          ],
          "description": "%config.bridge.mode%"
        },

        "zcode.bridge.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:4096/api/chat",
          "description": "%config.bridge.endpoint%"
        },
        "zcode.oauth.apiOrigin": {
          "type": "string",
          "default": "https://zcode.z.ai",
          "description": "%config.oauth.apiOrigin%"
        },
        "zcode.unsplashAccessKey": {
          "type": "string",
          "default": "",
          "description": "%config.unsplashAccessKey%"
        }
      }
    },
    "authentication": [
      {
        "id": "zcode",
        "label": "ZCode"
      }
    ],
    "configurationDefaults": {
      "workbench.sideBar.location": "left",
      "zcode.layout.chatPosition": "center",
      "workbench.panel.defaultLocation": "bottom",
      "workbench.secondarySideBar.defaultVisibility": "maximizedInWorkspace",
      "workbench.secondarySideBar.forceMaximized": true,
      "workbench.activityBar.location": "default",
      "workbench.startupEditor": "none"
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "zcode",
          "title": "%container.title%",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "zcode": [
        {
          "type": "webview",
          "id": "zcode.chatView",
          "name": "%view.chat%",
          "visibility": "visible"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "zcode.chat",
        "fullName": "%chat.fullName%",
        "name": "zcode",
        "description": "%chat.description%",
        "isDefault": false,
        "modes": [
          "ask",
          "agent",
          "edit"
        ],
        "commands": [
          {
            "name": "provider",
            "description": "%chat.command.provider%"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "zcode.openChat",
        "title": "%command.openChat%",
        "category": "%command.category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "zcode.openChatDevTools",
        "title": "%command.openChatDevTools%",
        "category": "%command.category%",
        "icon": "$(debug)"
      },
      {
        "command": "zcode.addSelectionToChat",
        "title": "%command.addSelectionToChat%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "zcode.newChat",
        "title": "%command.newChat%",
        "category": "%command.category%",
        "icon": "$(plus)"
      },
      {
        "command": "zcode.toggleHistory",
        "title": "%command.toggleHistory%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "zcode.searchHistory",
        "title": "%command.searchHistory%",
        "category": "%command.category%",
        "icon": "$(search)"
      },
      {
        "command": "zcode.plugins",
        "title": "%command.plugins%",
        "category": "%command.category%",
        "icon": "$(extensions)"
      },
      {
        "command": "zcode.closeActiveTab",
        "title": "%command.closeActiveTab%",
        "category": "%command.category%"
      },
      {
        "command": "zcode.switchBrain",
        "title": "%command.switchBrain%",
        "category": "%command.category%",
        "icon": "$(hubot)"
      },
      {
        "command": "zcode.switchProvider",
        "title": "%command.switchProvider%",
        "category": "%command.category%",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "zcode.setDeepseekApiKey",
        "title": "%command.setDeepseekApiKey%",
        "category": "%command.category%",
        "icon": "$(key)"
      },
      {
        "command": "zcode.switchModel",
        "title": "%command.switchModel%",
        "category": "%command.category%",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "zcode.switchReasoningLevel",
        "title": "%command.switchReasoningLevel%",
        "category": "%command.category%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "zcode.showBridgeStatus",
        "title": "%command.showBridgeStatus%",
        "category": "%command.category%"
      },
      {
        "command": "zcode.manageAccount",
        "title": "%command.manageAccount%",
        "category": "%command.category%",
        "icon": "$(account)"
      },
      {
        "command": "zcode.signIn",
        "title": "%command.signIn%",
        "category": "%command.category%",
        "icon": "$(sign-in)"
      },
      {
        "command": "zcode.signOut",
        "title": "%command.signOut%",
        "category": "%command.category%",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zcode.openChat"
        },
        {
          "command": "zcode.addSelectionToChat"
        },
        {
          "command": "zcode.newChat"
        },
        {
          "command": "zcode.toggleHistory"
        },
        {
          "command": "zcode.searchHistory"
        },
        {
          "command": "zcode.plugins"
        },
        {
          "command": "zcode.closeActiveTab"
        },
        {
          "command": "zcode.switchBrain"
        },
        {
          "command": "zcode.switchProvider"
        },
        {
          "command": "zcode.switchModel"
        },
        {
          "command": "zcode.switchReasoningLevel"
        },
        {
          "command": "zcode.showBridgeStatus"
        },
        {
          "command": "zcode.manageAccount"
        },
        {
          "command": "zcode.signIn"
        },
        {
          "command": "zcode.signOut"
        }
      ],
      "editor/context": [
        {
          "command": "zcode.addSelectionToChat",
          "when": "editorTextFocus",
          "group": "navigation@100"
        }
      ],
      "view/title": [
        {
          "command": "zcode.switchBrain",
          "when": "view == zcode.chatView",
          "group": "1_more@1"
        },
        {
          "command": "zcode.switchProvider",
          "when": "view == zcode.chatView",
          "group": "1_more@2"
        },
        {
          "command": "zcode.setDeepseekApiKey",
          "when": "view == zcode.chatView",
          "group": "1_more@3"
        },
        {
          "command": "zcode.manageAccount",
          "when": "view == zcode.chatView",
          "group": "1_more@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zcode.openChat",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "zcode.closeActiveTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "focusedView == 'zcode.chatView' || (auxiliaryBarFocus && activeAuxiliary == 'workbench.view.extension.zcode')"
      },
      {
        "command": "zcode.addSelectionToChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
